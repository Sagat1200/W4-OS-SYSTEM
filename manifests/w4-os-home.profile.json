{
  "schema_version": 1,
  "kind": "edition-profile",
  "id": "w4-os-home",
  "name": "W4 OS Home",
  "inherits": "w4-linux-base",
  "meta_packages": {
    "required": [
      "w4-desktop-meta",
      "w4-desktop-gnome-meta",
      "w4-home-meta"
    ],
    "recommended": []
  },
  "packages": {
    "required": [
      "at-spi2-core",
      "evince",
      "firefox-esr",
      "gdm3",
      "gnome-accessibility-themes",
      "gnome-control-center",
      "gnome-session",
      "gnome-shell",
      "gnome-software",
      "gnome-terminal",
      "libatk-adaptor",
      "libreoffice",
      "nautilus",
      "os-prober",
      "orca",
      "pipewire",
      "speech-dispatcher",
      "vlc",
      "xdg-desktop-portal",
      "xdg-desktop-portal-gnome"
    ],
    "recommended": [],
    "remove": []
  },
  "features": [
    "accessibility-baseline",
    "desktop-defaults",
    "gnome-gdm-default-route",
    "home-onboarding",
    "local-backup-ready",
    "reversible-branding-defaults"
  ],
  "notes": [
    "Perfil inicial para tareas domesticas y uso general.",
    "Las selecciones podran cambiar cuando se cierre el escritorio oficial y el conjunto minimo de aplicaciones V1.",
    "La ruta visual base actual de Home se resuelve sobre GNOME + GDM mediante defaults reversibles materializados desde el overlay."
  ]
}
