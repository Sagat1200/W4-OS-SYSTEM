{
  "schema_version": 1,
  "kind": "edition-profile",
  "id": "w4-os-business",
  "name": "W4 OS Business",
  "inherits": "w4-linux-base",
  "meta_packages": {
    "required": [
      "w4-desktop-meta",
      "w4-desktop-kde-meta",
      "w4-business-meta"
    ],
    "recommended": []
  },
  "packages": {
    "required": [
      "curl",
      "dolphin",
      "jq",
      "os-prober",
      "konsole",
      "plasma-desktop",
      "plasma-nm",
      "plasma-workspace",
      "pipewire",
      "sddm",
      "systemsettings",
      "xdg-desktop-portal",
      "xdg-desktop-portal-kde"
    ],
    "recommended": [
      "openvpn",
      "wireguard-tools"
    ],
    "remove": []
  },
  "features": [
    "desktop-defaults",
    "business-policy-hooks",
    "device-enrollment-ready",
    "inventory-ready",
    "kde-sddm-default-route",
    "reversible-branding-defaults"
  ],
  "notes": [
    "Perfil inicial para piloto Business.",
    "No habilita gestion remota arbitraria; solo prepara la base para integraciones tipadas posteriores.",
    "La ruta visual base actual de Business se resuelve sobre KDE Plasma + SDDM mediante defaults reversibles materializados desde el overlay."
  ]
}
