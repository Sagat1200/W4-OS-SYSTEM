{
    "live_bundle_schema_version": 1,
    "kind": "live-bundle",
    "profile_id": "w4-os-home",
    "profile_name": "W4 OS Home",
    "base_manifest_id": "w4-linux-base",
    "source_build_input": "w4-os-home.build-input.json",
    "source_overlay_manifest": "overlay-manifest.json",
    "source_overlay_payload": "files\/system-overlay",
    "branding": {
        "profile_id": "w4-os-home",
        "profile_name": "W4 OS Home",
        "edition": "Home",
        "live_user": "w4live",
        "live_hostname": "w4-home-live",
        "distribution_name": "W4 OS",
        "default_target": "graphical.target",
        "volume_id": "W4_OS_HOME_LIVE"
    },
    "edition_policy": {
        "path": "config\/editions\/home\/policy.json",
        "default_target": "graphical.target"
    },
    "live_stack": {
        "packages": [
            "live-boot",
            "live-config"
        ],
        "bootloader_ready": false,
        "iso_tooling_required": [
            "xorriso",
            "grub-mkstandalone"
        ]
    },
    "next_steps": [
        "componer image-root y filesystem.squashfs",
        "validar live-boot en VM",
        "instalar tooling de ISO si aplica",
        "empaquetar ISO arrancable"
    ],
    "generated_files": [
        "compose-live.sh",
        "files\/.disk\/info",
        "files\/README-LIVE.txt",
        "files\/boot\/grub\/grub.cfg",
        "files\/system-overlay\/"
    ]
}
