{
    "rootfs_schema_version": 1,
    "kind": "rootfs-bundle",
    "profile_id": "w4-os-home",
    "profile_name": "W4 OS Home",
    "base_manifest_id": "w4-linux-base",
    "source_build_input": "w4-os-home.build-input.json",
    "target": {
        "release_channel": "testing",
        "image_format": "iso"
    },
    "upstream": {
        "distribution": "debian",
        "track": "stable",
        "codename": "trixie",
        "architectures": [
            "amd64"
        ],
        "boot_modes": [
            "uefi"
        ]
    },
    "repositories": [
        "debian-main",
        "debian-security",
        "w4-main"
    ],
    "packages": {
        "required": [
            "apparmor",
            "apt",
            "at-spi2-core",
            "base-files",
            "bash",
            "btrfs-progs",
            "ca-certificates",
            "evince",
            "firefox-esr",
            "gdm3",
            "gnome-accessibility-themes",
            "gnome-control-center",
            "gnome-session",
            "gnome-shell",
            "gnome-software",
            "gnome-terminal",
            "grub-efi-amd64",
            "libatk-adaptor",
            "libreoffice",
            "linux-image-amd64",
            "nautilus",
            "network-manager",
            "orca",
            "os-prober",
            "php-cli",
            "pipewire",
            "shim-signed",
            "speech-dispatcher",
            "sudo",
            "systemd",
            "ufw",
            "vlc",
            "xdg-desktop-portal",
            "xdg-desktop-portal-gnome"
        ],
        "recommended": [
            "flatpak",
            "fwupd",
            "snapper"
        ]
    },
    "meta_packages": {
        "required": [
            "w4-base-meta",
            "w4-desktop-gnome-meta",
            "w4-desktop-meta",
            "w4-home-meta"
        ],
        "recommended": []
    },
    "features": [
        "accessibility-baseline",
        "desktop-defaults",
        "gnome-gdm-default-route",
        "home-onboarding",
        "local-backup-ready",
        "reversible-branding-defaults"
    ],
    "rootfs_directories": [
        "\/boot",
        "\/boot\/efi",
        "\/dev",
        "\/etc",
        "\/etc\/apt",
        "\/etc\/apt\/sources.list.d",
        "\/etc\/default",
        "\/etc\/systemd\/system",
        "\/home",
        "\/proc",
        "\/root",
        "\/run",
        "\/sys",
        "\/tmp",
        "\/usr",
        "\/usr\/local",
        "\/var",
        "\/var\/cache\/apt",
        "\/var\/lib\/apt",
        "\/var\/lib\/dpkg",
        "\/var\/log",
        "\/var\/tmp"
    ],
    "identity_cleanup": [
        "\/etc\/machine-id",
        "\/var\/lib\/dbus\/machine-id"
    ],
    "generated_files": [
        "build-rootfs.sh",
        "directories.list",
        "packages.recommended.list",
        "packages.required.list",
        "repositories.list"
    ],
    "next_steps": [
        "configurar primer inicio",
        "anadir instalador y componentes live",
        "generar formato de imagen",
        "ejecutar pruebas de arranque"
    ]
}
