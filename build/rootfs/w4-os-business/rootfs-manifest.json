{
    "rootfs_schema_version": 1,
    "kind": "rootfs-bundle",
    "profile_id": "w4-os-business",
    "profile_name": "W4 OS Business",
    "base_manifest_id": "w4-linux-base",
    "source_build_input": "w4-os-business.build-input.json",
    "target": {
        "release_channel": "stable",
        "image_format": "iso"
    },
    "upstream": {
        "distribution": "debian",
        "track": "stable",
        "codename": "trixie",
        "architectures": [
            "amd64"
        ],
        "boot_modes": [
            "uefi"
        ]
    },
    "repositories": [
        "debian-main",
        "debian-security",
        "w4-main"
    ],
    "packages": {
        "required": [
            "apparmor",
            "apt",
            "base-files",
            "bash",
            "btrfs-progs",
            "ca-certificates",
            "curl",
            "dolphin",
            "grub-efi-amd64",
            "jq",
            "konsole",
            "linux-image-amd64",
            "network-manager",
            "os-prober",
            "php-cli",
            "pipewire",
            "plasma-desktop",
            "plasma-nm",
            "plasma-workspace",
            "sddm",
            "shim-signed",
            "sudo",
            "systemd",
            "systemsettings",
            "ufw",
            "xdg-desktop-portal",
            "xdg-desktop-portal-kde"
        ],
        "recommended": [
            "flatpak",
            "fwupd",
            "openvpn",
            "snapper",
            "wireguard-tools"
        ]
    },
    "meta_packages": {
        "required": [
            "w4-base-meta",
            "w4-business-meta",
            "w4-desktop-kde-meta",
            "w4-desktop-meta"
        ],
        "recommended": []
    },
    "features": [
        "desktop-defaults",
        "business-policy-hooks",
        "device-enrollment-ready",
        "inventory-ready",
        "kde-sddm-default-route",
        "reversible-branding-defaults"
    ],
    "rootfs_directories": [
        "\/boot",
        "\/boot\/efi",
        "\/dev",
        "\/etc",
        "\/etc\/apt",
        "\/etc\/apt\/sources.list.d",
        "\/etc\/default",
        "\/etc\/systemd\/system",
        "\/home",
        "\/proc",
        "\/root",
        "\/run",
        "\/sys",
        "\/tmp",
        "\/usr",
        "\/usr\/local",
        "\/var",
        "\/var\/cache\/apt",
        "\/var\/lib\/apt",
        "\/var\/lib\/dpkg",
        "\/var\/log",
        "\/var\/tmp"
    ],
    "identity_cleanup": [
        "\/etc\/machine-id",
        "\/var\/lib\/dbus\/machine-id"
    ],
    "generated_files": [
        "build-rootfs.sh",
        "directories.list",
        "packages.recommended.list",
        "packages.required.list",
        "repositories.list"
    ],
    "next_steps": [
        "configurar primer inicio",
        "anadir instalador y componentes live",
        "generar formato de imagen",
        "ejecutar pruebas de arranque"
    ]
}
