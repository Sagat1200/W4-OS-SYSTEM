{
    "overlay_schema_version": 1,
    "kind": "system-overlay",
    "profile_id": "w4-os-business",
    "profile_name": "W4 OS Business",
    "base_manifest_id": "w4-linux-base",
    "source_build_input": "w4-os-business.build-input.json",
    "branding": {
        "product_name": "W4 OS System",
        "distribution_name": "W4 OS",
        "edition": "Business",
        "hostname": "w4-business",
        "live_hostname": "w4-business-live",
        "live_user": "w4live"
    },
    "edition_policy": {
        "path": "config\/editions\/business\/policy.json",
        "default_target": "graphical.target"
    },
    "features": [
        "desktop-defaults",
        "business-policy-hooks",
        "device-enrollment-ready",
        "inventory-ready",
        "kde-sddm-default-route",
        "reversible-branding-defaults"
    ],
    "services": [
        "w4-firstboot.service",
        "w4-live-prep.service"
    ],
    "security": {
        "apparmor": {
            "bootloader_defaults": "files\/etc\/default\/grub.d\/50-w4-security.cfg",
            "activation": "firstboot-enables-service"
        },
        "firewall": {
            "tool": "ufw",
            "defaults": "deny-incoming-allow-outgoing",
            "config_files": [
                "files\/etc\/default\/ufw",
                "files\/etc\/ufw\/ufw.conf"
            ]
        }
    },
    "generated_files": [
        "apply-overlay.sh",
        "files\/etc\/default\/grub.d\/50-w4-security.cfg",
        "files\/etc\/default\/ufw",
        "files\/etc\/default\/w4-live",
        "files\/etc\/hostname",
        "files\/etc\/hosts",
        "files\/etc\/issue",
        "files\/etc\/issue.net",
        "files\/etc\/motd",
        "files\/etc\/skel\/.config\/w4-os\/profile.env",
        "files\/etc\/systemd\/system\/w4-firstboot.service",
        "files\/etc\/systemd\/system\/w4-live-prep.service",
        "files\/etc\/ufw\/ufw.conf",
        "files\/etc\/w4\/business-enrollment-readiness.json",
        "files\/etc\/w4\/desktop-defaults.json",
        "files\/etc\/w4\/os-release.env",
        "files\/etc\/w4\/profile.env",
        "files\/usr\/local\/lib\/w4\/w4-firstboot.sh",
        "files\/usr\/local\/lib\/w4\/w4-live-prep.sh",
        "files\/usr\/share\/w4\/branding\/business\/wallpapers\/w4-business-default.svg"
    ],
    "next_steps": [
        "aplicar overlay al rootfs",
        "verificar primer inicio",
        "integrar entorno live con la imagen final",
        "probar boot en VM"
    ],
    "desktop_defaults": {
        "path": "config\/editions\/business\/desktop-defaults.json",
        "application_method": "overlay-kde-defaults",
        "scope": "profile-defaults",
        "runtime_file": "files\/etc\/w4\/desktop-defaults.json",
        "dconf_profiles": [],
        "dconf_databases": [],
        "assets": [
            "files\/usr\/share\/w4\/branding\/business\/wallpapers\/w4-business-default.svg"
        ]
    },
    "business_enrollment_readiness": {
        "path": "config\/editions\/business\/enrollment-readiness.json",
        "runtime_file": "files\/etc\/w4\/business-enrollment-readiness.json",
        "initial_state": "unenrolled-ready",
        "policy_cache": "\/var\/lib\/w4\/policy\/last-known-policy.json",
        "inventory_state": "\/var\/lib\/w4\/inventory\/device-state.json"
    }
}
