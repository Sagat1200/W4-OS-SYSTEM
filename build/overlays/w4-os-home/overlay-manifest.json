{
    "overlay_schema_version": 1,
    "kind": "system-overlay",
    "profile_id": "w4-os-home",
    "profile_name": "W4 OS Home",
    "base_manifest_id": "w4-linux-base",
    "source_build_input": "w4-os-home.build-input.json",
    "branding": {
        "product_name": "W4 OS System",
        "distribution_name": "W4 OS",
        "edition": "Home",
        "hostname": "w4-home",
        "live_hostname": "w4-home-live",
        "live_user": "w4live"
    },
    "edition_policy": {
        "path": "config\/editions\/home\/policy.json",
        "default_target": "graphical.target"
    },
    "features": [
        "accessibility-baseline",
        "desktop-defaults",
        "gnome-gdm-default-route",
        "home-onboarding",
        "local-backup-ready",
        "reversible-branding-defaults"
    ],
    "services": [
        "w4-firstboot.service",
        "w4-live-prep.service"
    ],
    "security": {
        "apparmor": {
            "bootloader_defaults": "files\/etc\/default\/grub.d\/50-w4-security.cfg",
            "activation": "firstboot-enables-service"
        },
        "firewall": {
            "tool": "ufw",
            "defaults": "deny-incoming-allow-outgoing",
            "config_files": [
                "files\/etc\/default\/ufw",
                "files\/etc\/ufw\/ufw.conf"
            ]
        }
    },
    "generated_files": [
        "apply-overlay.sh",
        "files\/etc\/dconf\/db\/gdm.d\/00-w4-login",
        "files\/etc\/dconf\/db\/local.d\/00-w4-home",
        "files\/etc\/dconf\/profile\/gdm",
        "files\/etc\/dconf\/profile\/user",
        "files\/etc\/default\/grub.d\/50-w4-security.cfg",
        "files\/etc\/default\/ufw",
        "files\/etc\/default\/w4-live",
        "files\/etc\/hostname",
        "files\/etc\/hosts",
        "files\/etc\/issue",
        "files\/etc\/issue.net",
        "files\/etc\/motd",
        "files\/etc\/skel\/.config\/w4-os\/profile.env",
        "files\/etc\/systemd\/system\/w4-firstboot.service",
        "files\/etc\/systemd\/system\/w4-live-prep.service",
        "files\/etc\/ufw\/ufw.conf",
        "files\/etc\/w4\/control-center\/gnome-launchers-summary.txt",
        "files\/etc\/w4\/control-center\/gnome-launchers.json",
        "files\/etc\/w4\/desktop-defaults.json",
        "files\/etc\/w4\/os-release.env",
        "files\/etc\/w4\/profile.env",
        "files\/etc\/xdg\/autostart\/w4-home-onboarding-light-ui.desktop",
        "files\/usr\/local\/lib\/w4\/w4-firstboot.sh",
        "files\/usr\/local\/lib\/w4\/w4-home-onboarding-light-ui.sh",
        "files\/usr\/local\/lib\/w4\/w4-live-prep.sh",
        "files\/usr\/share\/applications\/w4-control-center-home-home.desktop",
        "files\/usr\/share\/applications\/w4-control-center-home-security.desktop",
        "files\/usr\/share\/applications\/w4-control-center-home-system.desktop",
        "files\/usr\/share\/applications\/w4-control-center-home-updates.desktop",
        "files\/usr\/share\/applications\/w4-home-onboarding-light-ui.desktop",
        "files\/usr\/share\/w4\/branding\/home\/wallpapers\/w4-home-default.svg",
        "files\/usr\/share\/w4\/home-onboarding\/home-onboarding-ui-manifest.json",
        "files\/usr\/share\/w4\/home-onboarding\/home-onboarding-ui.json",
        "files\/usr\/share\/w4\/home-onboarding\/index.html",
        "files\/usr\/share\/w4\/home-onboarding\/styles\/home-onboarding.css"
    ],
    "next_steps": [
        "aplicar overlay al rootfs",
        "verificar primer inicio",
        "integrar entorno live con la imagen final",
        "probar boot en VM"
    ],
    "desktop_defaults": {
        "path": "config\/editions\/home\/desktop-defaults.json",
        "application_method": "overlay-dconf",
        "scope": "profile-defaults",
        "runtime_file": "files\/etc\/w4\/desktop-defaults.json",
        "dconf_profiles": [
            "files\/etc\/dconf\/profile\/user",
            "files\/etc\/dconf\/profile\/gdm"
        ],
        "dconf_databases": [
            "files\/etc\/dconf\/db\/local.d\/00-w4-home",
            "files\/etc\/dconf\/db\/gdm.d\/00-w4-login"
        ],
        "assets": [
            "files\/usr\/share\/w4\/branding\/home\/wallpapers\/w4-home-default.svg"
        ]
    },
    "control_center_gnome_launchers": {
        "status": "integrated",
        "bundle_dir": "build\/control-center-gnome-launchers\/w4-os-home",
        "launcher_count": 4,
        "pending_module_count": 1,
        "runtime_manifest": "files\/etc\/w4\/control-center\/gnome-launchers.json",
        "runtime_summary": "files\/etc\/w4\/control-center\/gnome-launchers-summary.txt",
        "desktop_files": [
            "files\/usr\/share\/applications\/w4-control-center-home-home.desktop",
            "files\/usr\/share\/applications\/w4-control-center-home-security.desktop",
            "files\/usr\/share\/applications\/w4-control-center-home-system.desktop",
            "files\/usr\/share\/applications\/w4-control-center-home-updates.desktop"
        ]
    },
    "home_onboarding_light_ui": {
        "status": "integrated",
        "bundle_dir": "build\/home-onboarding-ui\/w4-os-home",
        "runtime_root": "files\/usr\/share\/w4\/home-onboarding",
        "entrypoint": "files\/usr\/share\/w4\/home-onboarding\/index.html",
        "manifest": "files\/usr\/share\/w4\/home-onboarding\/home-onboarding-ui-manifest.json",
        "visible_step_count": 5,
        "deferred_step_count": 4,
        "launcher": "files\/usr\/share\/applications\/w4-home-onboarding-light-ui.desktop",
        "autostart": "files\/etc\/xdg\/autostart\/w4-home-onboarding-light-ui.desktop",
        "launch_script": "files\/usr\/local\/lib\/w4\/w4-home-onboarding-light-ui.sh",
        "generated_files": [
            "files\/usr\/share\/w4\/home-onboarding\/home-onboarding-ui-manifest.json",
            "files\/usr\/share\/w4\/home-onboarding\/home-onboarding-ui.json",
            "files\/usr\/share\/w4\/home-onboarding\/index.html",
            "files\/usr\/share\/w4\/home-onboarding\/styles\/home-onboarding.css"
        ]
    }
}
